# Copie este arquivo para .env e preencha a chave. O .env ja esta no .gitignore
# e o docker compose o le automaticamente — a chave nunca vai para o repositorio.
#
#   cp .env.exemplo .env
#
# Pegue a chave em console.anthropic.com > Settings > API keys > Create Key.
# E preciso ter credito em Plans & Billing: a API e pre-paga e separada da
# assinatura do Claude.ai.

ANTHROPIC_API_KEY=

# true liga os agentes reais (claude-sonnet-5); false mantem os simulados,
# que rodam o loop inteiro sem custo de API.
USAR_CLAUDE=true
