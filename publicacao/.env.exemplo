# Variáveis da publicação. Copie para publicacao/.env e preencha.
#
#   cp publicacao/.env.exemplo publicacao/.env
#
# O .env real está no .gitignore. Nenhum valor daqui tem padrão no compose de
# produção: subir sem preencher falha na hora, em vez de subir errado e ninguém
# perceber até o primeiro aluno reclamar.

# Domínio já apontando para o IP desta máquina. O Caddy pede o certificado a
# partir dele — sem DNS correto, o Let's Encrypt recusa.
DOMINIO=fluentia.seudominio.com.br

# Banco. A senha não tem padrão de propósito.
BANCO_NOME=fluentia
BANCO_USUARIO=fluentia
BANCO_SENHA=

# Chave da API. console.anthropic.com → Settings → API keys → Create Key.
# É pré-paga e separada da assinatura do Claude.ai.
ANTHROPIC_API_KEY=

# Deixe true para os agentes reais. Com false o app sobe no modo simulado, que
# roda o loop inteiro sem custo mas não entende paráfrase.
USAR_CLAUDE=true

# Um fuso para todos: define a virada do dia na sequência de prática.
FUSO_HORARIO=America/Sao_Paulo

# Tetos por endereço de origem, por hora. Existem porque o contador por conta tem
# dois pontos cegos num endereço público: quem espalha tentativas por muitas contas
# nunca estoura o contador de nenhuma, e quem cria contas não erra nenhuma vez.
#
# Cadastro em 3: uma pessoa real cria uma conta, não três. Suba só se você mesmo
# for cadastrar várias de um lugar só.
CADASTROS_POR_ORIGEM_POR_HORA=3

# Recusas de login em 30, folgado de propósito: operadora de celular põe muita
# gente atrás do mesmo IP, e um teto apertado barraria gente inocente junto.
RECUSAS_POR_ORIGEM_POR_HORA=30

# Recuperação de senha por e-mail. Vazio: o link vai para o log em vez de sair.
#
# Gmail: gere uma SENHA DE APP em myaccount.google.com → Segurança → Verificação em
# duas etapas → Senhas de app. A senha normal da conta não funciona.
#
# Trocar para Resend ou Brevo depois é mudar só estas linhas — nenhum código.
SMTP_SERVIDOR=smtp.gmail.com
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
