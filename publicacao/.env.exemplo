# Variáveis da publicação. Copie para publicacao/.env e preencha.
#
#   cp publicacao/.env.exemplo publicacao/.env
#
# O .env real está no .gitignore. Nenhum valor daqui tem padrão no compose de
# produção: subir sem preencher falha na hora, em vez de subir errado e ninguém
# perceber até o primeiro aluno reclamar.

# Domínio já apontando para o IP desta máquina. O Caddy pede o certificado a
# partir dele — sem DNS correto, o Let's Encrypt recusa.
DOMINIO=fluentia.seudominio.com.br

# Banco. A senha não tem padrão de propósito.
BANCO_NOME=fluentia
BANCO_USUARIO=fluentia
BANCO_SENHA=

# Chave da API. console.anthropic.com → Settings → API keys → Create Key.
# É pré-paga e separada da assinatura do Claude.ai.
ANTHROPIC_API_KEY=

# Deixe true para os agentes reais. Com false o app sobe no modo simulado, que
# roda o loop inteiro sem custo mas não entende paráfrase.
USAR_CLAUDE=true

# Um fuso para todos: define a virada do dia na sequência de prática.
FUSO_HORARIO=America/Sao_Paulo
